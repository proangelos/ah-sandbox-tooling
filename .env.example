# Copy this file to .env (gitignored) and edit as needed. .env is sourced
# after .env.default, so it only needs to state the deltas: paths that
# differ from .env.default, and/or repos .env.default doesn't know about.
#
# .env is a plain bash file, same as .env.default -- not real dotenv syntax.

# Override an existing repo's path (e.g. your repos live under ~/code
# instead of ~/dev, or forerunner's sync tooling isn't what put a repo
# where it is for you):
REPOS[forerunner]="$HOME/code/forerunner"

# Add a repo of your own that .env.default doesn't define. SOURCE_BRANCHES
# is required -- create.sh errors out if a requested repo doesn't have one.
# REPO_GROUP/REPO_DESC are optional (only affect the generated sandbox
# README). Adding to OPTIONAL_REPOS is optional too -- it's only needed so
# the repo shows up in create.sh's usage/help text; it's usable via
# WITH="my-service" either way as soon as REPOS/SOURCE_BRANCHES have it.
REPOS[my-service]="$HOME/dev/my-service"
SOURCE_BRANCHES[my-service]="main"
OPTIONAL_REPOS+=(my-service)
