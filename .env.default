# Tracked default repo config, sourced by repos.sh.
#
# This is a plain bash file (associative arrays), not real dotenv KEY=VALUE
# syntax -- repo entries need multiple fields (path, branch, group,
# description), which a flat KEY=VALUE format can't hold cleanly. The
# .env.default/.env naming is just a convention: tracked shared defaults
# here, untracked per-developer overrides/additions in .env (gitignored).
# See .env.example for the override syntax.

declare -A REPOS=(
  [forerunner]="$HOME/dev/forerunner"
  [ahmonolith]="$HOME/dev/forerunner/repos/ahmonolith"
  [ahportal-ui]="$HOME/dev/forerunner/repos/ahportal-ui"
  [v7-react]="$HOME/dev/forerunner/repos/v7-react"
  [cms-api]="$HOME/dev/cms-api"
  [cms-ui]="$HOME/dev/cms-ui"
  [tango-service]="$HOME/dev/tango-service"
  [p2p-service]="$HOME/dev/p2p-service"
)

# Always included in every new sandbox.
BASE_REPOS=(forerunner ahmonolith ahportal-ui v7-react)

# Available via WITH="repo1 repo2 ..."; not included unless requested.
OPTIONAL_REPOS=(cms-api cms-ui tango-service p2p-service)

# Branch each repo's sandbox worktree branches off of, after fetching it fresh
# from origin. One explicit entry per repo in REPOS -- no default/fallback
# guessing, since these repos have already diverged: some never had a
# feat/site-builder/main cut, and p2p-service uses its own feat/p2p/main
# convention entirely. create.sh errors out if a repo here has no entry.
declare -A SOURCE_BRANCHES=(
  [forerunner]="feat/site-builder/main"
  [ahmonolith]="feat/site-builder/main"
  [ahportal-ui]="feat/port/main"
  [v7-react]="feat/site-builder/main"
  [cms-api]="feat/site-builder/main"
  [cms-ui]="feat/site-builder/main"
  [tango-service]="master"
  [p2p-service]="feat/p2p/main"
)

# Which "family" each repo belongs to, purely for explaining relationships in
# the per-sandbox README (create.sh groups requested repos by this value) --
# doesn't affect worktree creation. See README.md at the repo root for the
# full story on why these groupings exist.
declare -A REPO_GROUP=(
  [forerunner]="forerunner monolith stack"
  [ahmonolith]="forerunner monolith stack"
  [ahportal-ui]="forerunner monolith stack"
  [v7-react]="forerunner monolith stack"
  [cms-api]="cms service pair"
  [cms-ui]="cms service pair"
  [tango-service]="all-services stack"
  [p2p-service]="all-services stack"
)

# One-line "what is this and how does it relate to its group" blurb per repo,
# used the same place as REPO_GROUP above.
declare -A REPO_DESC=(
  [forerunner]="local-dev orchestrator (docker compose + stack configs); its own sync tooling clones ahmonolith/ahportal-ui/v7-react into forerunner/repos/"
  [ahmonolith]="core monolith backend; nested under forerunner/repos/ in a normal checkout because forerunner's sync tooling put it there"
  [ahportal-ui]="portal frontend for the legacy client; nested under forerunner/repos/ in a normal checkout"
  [v7-react]="portal frontend for v8/blueprint clients; nested under forerunner/repos/ in a normal checkout"
  [cms-api]="CMS backend API; plain top-level sibling checkout, paired with cms-ui"
  [cms-ui]="CMS frontend; plain top-level sibling checkout, paired with cms-api"
  [tango-service]="plain top-level sibling checkout, paired with p2p-service"
  [p2p-service]="plain top-level sibling checkout, paired with tango-service"
)
